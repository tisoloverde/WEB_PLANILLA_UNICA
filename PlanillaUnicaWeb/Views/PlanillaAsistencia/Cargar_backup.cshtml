    <!-- INFORME MODAL MEJORADO -->
    <div class="modal fade" id="informeModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-file-earmark-text-fill me-2"></i>
                        Generar Informe de Asistencia
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="formInforme">
                        <!-- Centro de Costo -->
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-building me-2"></i>Centro de Costo</h6>
                            </div>
                            <div class="card-body">
                                <select id="informeCentroCosto" name="Gencencos_Id" class="form-select">
                                    <option value="">-- Seleccione Centro de Costo --</option>
                                    @foreach (var cc in lstCentroCosto)
                                    {
                                        <option value="@cc.Gencencos_Id">@cc.Gencencos_Descripcion</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Rango de Fechas -->
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-calendar-range me-2"></i>Rango de Fechas</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <label for="informeFechaInicio" class="form-label">Fecha Inicio</label>
                                        <input type="date" id="informeFechaInicio" name="FechaInicio" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label for="informeFechaFin" class="form-label">Fecha Fin</label>
                                        <input type="date" id="informeFechaFin" name="FechaFin" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tipo de Informe -->
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-file-earmark-bar-graph me-2"></i>Tipo de Informe</h6>
                            </div>
                            <div class="card-body">
                                <select id="informeTipo" name="TipoInforme" class="form-select">
                                    <option value="faltas_permisos">📋 Faltas y Permisos</option>
                                    <option value="horas_extras_atrasos">⏰ Horas Extras y Atrasos</option>
                                    <option value="general_mensual">📊 General Mensual</option>
                                    <option value="validacion_mensual">✅ Validación Mensual</option>
                                </select>
                            </div>
                        </div>

                        <!-- Opciones de Horas Extras (solo visible cuando se selecciona horas_extras_atrasos) -->
                        <div id="opcionesHorasExtras" class="card mb-3" style="display: none;">
                            <div class="card-header bg-warning text-dark">
                                <h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>Opciones de Horas Extras y Atrasos</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="toggleHE50" checked>
                                            <label class="form-check-label" for="toggleHE50">
                                                <strong>HE 50%</strong>
                                                <small class="text-muted d-block">Horas Extras al 50%</small>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="toggleHE100" checked>
                                            <label class="form-check-label" for="toggleHE100">
                                                <strong>HE 100%</strong>
                                                <small class="text-muted d-block">Horas Extras al 100%</small>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="toggleAtraso" checked>
                                            <label class="form-check-label" for="toggleAtraso">
                                                <strong>Atrasos</strong>
                                                <small class="text-muted d-block">Descuentos por atrasos</small>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="alert alert-info mt-3 mb-0">
                                    <i class="bi bi-info-circle me-2"></i>
                                    <small>Seleccione los conceptos que desea incluir en el informe de Horas Extras y Atrasos.</small>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" id="btnCerrarInforme" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Cerrar
                    </button>
                    <button type="button" id="btnGenerarInforme" class="btn btn-success">
                        <i class="bi bi-download me-1"></i>Generar Informe
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            // Abrir modal al clickear el boton Informe
            $('#btnInforme').on('click', function (e) {
                e.preventDefault();
                $('#informeModal').modal('show');
            });

            // Cerrar modal
            $('#btnCerrarInforme').on('click', function () {
                $('#informeModal').modal('hide');
            });

            // Manejar cambio en el tipo de informe para mostrar/ocultar opciones de horas extras
            $('#informeTipo').on('change', function () {
                var tipoSeleccionado = $(this).val();
                
                if (tipoSeleccionado === 'horas_extras_atrasos') {
                    $('#opcionesHorasExtras').slideDown(300);
                } else {
                    $('#opcionesHorasExtras').slideUp(300);
                }
            });

            // Validar que al menos una opción esté seleccionada para horas extras
            function validarOpcionesHorasExtras() {
                if ($('#informeTipo').val() === 'horas_extras_atrasos') {
                    var he50 = $('#toggleHE50').is(':checked');
                    var he100 = $('#toggleHE100').is(':checked');
                    var atraso = $('#toggleAtraso').is(':checked');
                    
                    return he50 || he100 || atraso;
                }
                return true;
            }

            // Generar informe con validaciones mejoradas
            $('#btnGenerarInforme').on('click', function () {
                var centro = $('#informeCentroCosto').val();
                var fecIni = $('#informeFechaInicio').val();
                var fecFin = $('#informeFechaFin').val();
                var tipo = $('#informeTipo').val();

                // Validaciones básicas
                if (!centro) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Centro de Costo Requerido',
                        text: 'Por favor seleccione un Centro de Costo.',
                        confirmButtonColor: '#e60012'
                    });
                    return;
                }

                if (!fecIni || !fecFin) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Fechas Requeridas',
                        text: 'Por favor seleccione Fecha de Inicio y Fecha Fin.',
                        confirmButtonColor: '#e60012'
                    });
                    return;
                }

                if (new Date(fecIni) > new Date(fecFin)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Rango de Fechas Inválido',
                        text: 'La Fecha de Inicio no puede ser posterior a la Fecha Fin.',
                        confirmButtonColor: '#e60012'
                    });
                    return;
                }

                // Validar opciones de horas extras si está seleccionado
                if (!validarOpcionesHorasExtras()) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Opciones de Horas Extras',
                        text: 'Para el informe de Horas Extras y Atrasos, debe seleccionar al menos una opción (HE50, HE100 o Atrasos).',
                        confirmButtonColor: '#e60012'
                    });
                    return;
                }

                // Recopilar datos del formulario
                var datosInforme = {
                    centro: centro,
                    fecIni: fecIni,
                    fecFin: fecFin,
                    tipo: tipo
                };

                // Si es horas extras, agregar las opciones seleccionadas
                if (tipo === 'horas_extras_atrasos') {
                    datosInforme.incluirHE50 = $('#toggleHE50').is(':checked');
                    datosInforme.incluirHE100 = $('#toggleHE100').is(':checked');
                    datosInforme.incluirAtrasos = $('#toggleAtraso').is(':checked');
                }

                // Mostrar loading y procesar
                Swal.fire({
                    title: 'Generando Informe...',
                    html: 'Por favor espere mientras se procesa la información.',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // TODO: Implementar llamada al controlador
                console.log('Datos del informe:', datosInforme);
                
                // Simulación temporal - reemplazar con llamada real al servidor
                setTimeout(function() {
                    Swal.fire({
                        icon: 'success',
                        title: 'Informe Generado',
                        text: 'El informe se ha generado correctamente.',
                        confirmButtonColor: '#28a745'
                    });
                    $('#informeModal').modal('hide');
                }, 2000);

                /* 
                // Ejemplo de implementación real:
                $.ajax({
                    url: '@Url.Action("GenerarInforme", "PlanillaAsistencia")',
                    type: 'POST',
                    data: datosInforme,
                    success: function(response) {
                        if (response.success) {
                            // Descargar archivo o mostrar resultado
                            window.location.href = response.downloadUrl;
                            Swal.close();
                            $('#informeModal').modal('hide');
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Error', 'Error al generar el informe', 'error');
                    }
                });
                */
            });

            // Inicializar fechas con valores por defecto
            $('#informeModal').on('show.bs.modal', function () {
                // Establecer fecha fin como hoy
                var hoy = new Date().toISOString().split('T')[0];
                $('#informeFechaFin').val(hoy);
                
                // Establecer fecha inicio como primer día del mes actual
                var primerDiaMes = new Date(new Date().getFullYear(), new Date().getMonth(), 1).toISOString().split('T')[0];
                $('#informeFechaInicio').val(primerDiaMes);
                
                // Revisar el tipo de informe seleccionado y mostrar/ocultar opciones de horas extras
                var tipoSeleccionado = $('#informeTipo').val();
                if (tipoSeleccionado === 'horas_extras_atrasos') {
                    $('#opcionesHorasExtras').show();
                } else {
                    $('#opcionesHorasExtras').hide();
                }
            });
        });
    </script>

<script>
    var centrosCostoList = @Html.Raw(Json.Encode(lstCentroCosto));

    $(document).ready(function () {
        // Cuando se seleccione una empresa para cargar los centros de costo asociados
        $('#empresaDropdown').change(function () {
            var table = $('#tablaPlanilla').DataTable();
            table.clear().draw();
            var empresaId = $(this).val(); // Obtener el ID de la empresa

            // Limpiar el dropdown de centros de costo
            $('#centroCostoDropdown').empty();
            $('#centroCostoDropdown').append($('<option>').val('').text('-- Seleccione Centro de Costo --')); // Opción por defecto

            // Si hay una empresa seleccionada
            if (empresaId) {
                // Filtrar los centros de costo que pertenecen a la empresa seleccionada
                var filteredCentrosCosto = centrosCostoList.filter(function (item) {
                    return item.Genemp_Id == empresaId; // Comparar con la empresa seleccionada
                });

                // Llenar el dropdown con las centros de costo filtrados
                $.each(filteredCentrosCosto, function (index, item) {
                    $('#centroCostoDropdown').append($('<option>').val(item.Gencencos_Id).text(item.Gencencos_Codigo + ' - ' + item.Gencencos_Descripcion));
                });
            }
        });

        // Seteo de centro de costo al cargar en búsqueda
        let empresaId = document.getElementById('empresaDropdown').value;

        if (empresaId == '') {
            $('#empresaDropdown').val(@filtroPlanilla.Genemp_Id);
            $('#periodoDropdown').val(@filtroPlanilla.Periodo);
            empresaId = document.getElementById('empresaDropdown').value;
        }


        var filteredCentrosCosto = centrosCostoList.filter(function (item) {
            return item.Genemp_Id == empresaId; // Comparar con la empresa seleccionada
        });

        // Llenar el dropdown con las centros de costo filtrados
        $.each(filteredCentrosCosto, function (index, item) {
            $('#centroCostoDropdown').append($('<option>').val(item.Gencencos_Id).text(item.Gencencos_Codigo + ' - ' + item.Gencencos_Descripcion));
        });
        $('#centroCostoDropdown').val(@filtroPlanilla.Gencencos_Id);

        // Carga y seteo de semanas por periodo
        $.ajax({
            type: 'GET',
            url: '@Url.Action("BuscaSemanasPeriodo", "PlanillaAsistencia")',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data: { periodo: @filtroPlanilla.Periodo },

            success: function (response) {
                // Limpiar select
                $('#numeroSemanaDropdown').empty();

                // Agregar opción por defecto
                $('#numeroSemanaDropdown').append('<option value="">Seleccione Semana</option>');

                // Llenar con datos de la API
                if (response.data && response.data.length > 0) {
                    $.each(response.data, function (index, item) {
                        if (item.NumeroSemana == @filtroPlanilla.NumeroSemana ) {
                            $('#numeroSemanaDropdown').append(`<option value="${item.NumeroSemana}" data-fecini="${item.FechaInicioSemana}" data-fecfin="${item.FechaFinSemana}" selected> Semana ${item.NumeroSemana} del ${item.Ano} ( ${item.FechaInicioSemana} al ${item.FechaFinSemana} )</option>`);
                            $('#filtroPlanilla_FechaInicio').val(item.FechaInicioSemana);
                            $('#filtroPlanilla_FechaTermino').val(item.FechaFinSemana);
                        } else
                            $('#numeroSemanaDropdown').append(`<option value="${item.NumeroSemana}" data-fecini="${item.FechaInicioSemana}" data-fecfin="${item.FechaFinSemana}" > Semana ${item.NumeroSemana} del ${item.Ano} ( ${item.FechaInicioSemana} al ${item.FechaFinSemana} )</option>`);

                    });
                } else {
                    $('#numeroSemanaDropdown').append('<option value="">No hay datos disponibles</option>');
                }
            },
            error: function (xhr, status, error) {
                console.error('Error al cargar datos:', error);
                $('#numeroSemanaDropdown').empty();
                $('#numeroSemanaDropdown').append('<option value="">Error al cargar semanas</option>');
            },
            complete: function () {
                // Habilitar select
                $('#numeroSemanaDropdown').prop('disabled', false);
            }
        });


    });

</script>