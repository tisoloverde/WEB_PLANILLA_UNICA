<!-- INFORME MODAL -->
<div class="modal fade" id="informeModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg col-10 mx-auto" role="document">
        <div class="modal-content" style="border-radius: 15px; border: none; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #5E9217, #4A7613); color: white; border-radius: 15px 15px 0 0; border-bottom: none; padding: 1.25rem;">
                <h5 class="modal-title" style="color: white; font-weight: 600; margin: 0;">
                    <i class="bi bi-file-earmark-bar-graph me-2"></i>Generar Informe
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 1.5rem; background: linear-gradient(135deg, #f8f9fa, #e9ecef);">
                <form id="formInforme">
                    <div class="form-group mb-2">
                        <label for="informeCentroCosto" class="label-with-icon">
                            <i class="bi bi-geo-alt"></i>
                            Centro de Costo
                        </label>
                        <select id="informeCentroCosto" name="Gencencos_Id" class="form-control">
                            <option value="">-- Seleccione Centro de Costo --</option>
                            <option value="0">TODOS</option>
                            @foreach (var cc in lstCentroCostoTodos)
                            {
                                <option value="@cc.Gencencos_Id">@cc.Gencencos_Descripcion</option>
                            }
                        </select>
                    </div>

                    <div class="row" id="campoFechas">
                        <div class="col-md-6 form-group mb-2">
                            <label for="informeFechaInicio" class="label-with-icon">
                                <i class="bi bi-calendar-event"></i>
                                Fecha Inicio
                            </label>
                            <input type="date" id="informeFechaInicio" name="FechaInicio" class="form-control" />
                        </div>
                        <div class="col-md-6 form-group mb-2">
                            <label for="informeFechaFin" class="label-with-icon">
                                <i class="bi bi-calendar-check"></i>
                                Fecha Fin
                            </label>
                            <input type="date" id="informeFechaFin" name="FechaFin" class="form-control" />
                        </div>
                    </div>
                    <!-- Campo de periodo para informes mensuales -->
                    <div class="form-group mb-2" id="campoPeriodo" style="display: none;">
                        <label for="informePeriodo" class="label-with-icon">
                            <i class="bi bi-calendar3"></i>
                            Periodo (YYYY-MM)
                        </label>
                        <input type="month" id="informePeriodo" name="Periodo" class="form-control" />
                    </div>
                    <div class="form-group mb-2">
                        <label for="informeTipo" class="label-with-icon">
                            <i class="bi bi-file-earmark-text"></i>
                            Tipo de Informe
                        </label>
                        <select id="informeTipo" name="TipoInforme" class="form-control">
                            <option value="">-- Seleccione el tipo de informe --</option>
                            <option value="faltas_permisos">Faltas y Permisos</option>
                            <option value="horas_extras_atrasos">Horas Extras y Atrasos</option>
                            <option value="general_mensual">General Mensual</option>
                            <option value="validacion_mensual">Validacion Mensual</option>
                        </select>
                    </div>

                    <!-- Opciones especificas para Horas Extras y Atrasos -->
                    <div id="opcionesHorasExtras" style="display: none; margin-top: 20px; padding: 15px; background: #f8f9fa; border-radius: 8px; border: 1px solid #e9ecef;">
                        <h6 style="color: #5E9217; margin-bottom: 15px;">
                            <i class="bi bi-gear me-2"></i>Opciones de Informe
                        </h6>
                        
                        <div class="row">
                            <div class="col-md-4">
                                <div class="switch-container" style="display: flex; flex-direction: column; align-items: center; margin-bottom: 15px;">
                                    <div class="form-check form-switch" style="margin-bottom: 8px;">
                                        <input class="form-check-input" type="checkbox" id="toggleHE50" checked>
                                    </div>
                                    <label for="toggleHE50" class="switch-labels" style="text-align: center; font-size: 14px; color: #5E9217; font-weight: 600;">
                                        <i class="bi bi-clock me-1"></i>HE50
                                    </label>
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="switch-container" style="display: flex; flex-direction: column; align-items: center; margin-bottom: 15px;">
                                    <div class="form-check form-switch" style="margin-bottom: 8px;">
                                        <input class="form-check-input" type="checkbox" id="toggleHE100" checked>
                                    </div>
                                    <label for="toggleHE100" class="switch-labels" style="text-align: center; font-size: 14px; color: #5E9217; font-weight: 600;">
                                        <i class="bi bi-clock-history me-1"></i>HE100
                                    </label>
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="switch-container" style="display: flex; flex-direction: column; align-items: center; margin-bottom: 15px;">
                                    <div class="form-check form-switch" style="margin-bottom: 8px;">
                                        <input class="form-check-input" type="checkbox" id="toggleAtraso" checked>
                                    </div>
                                    <label for="toggleAtraso" class="switch-labels" style="text-align: center; font-size: 14px; color: #5E9217; font-weight: 600;">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Atrasos
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #e9ecef; padding: 1.25rem; background: #f8f9fa;">
                <button type="button" id="btnCerrarInforme" class="btn btn-modern-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cerrar
                </button>
                <button type="button" id="btnGenerarInforme" class="btn btn-modern-success">
                    <i class="bi bi-file-earmark-pdf me-2"></i>Generar
                </button>
            </div>
        </div>
    </div>
</div>

<script>

    var centrosCostoList = @Html.Raw(Json.Encode(lstCentroCosto));

    $(document).ready(function () {
        // Cuando se seleccione una empresa para cargar los centros de costo asociados
        $('#empresaDropdown').change(function () {
            var table = $('#tablaPlanilla').DataTable();
            table.clear().draw();

            var empresaId = $(this).val(); // Obtener el ID de la empresa

            // Limpiar el dropdown de centros de costo
            $('#centroCostoDropdown').empty();
            $('#centroCostoDropdown').append($('<option>').val('').text('-- Seleccione Centro de Costo --')); // Opcion por defecto

            // Si hay una empresa seleccionada
            if (empresaId) {
                // Filtrar los centros de costo que pertenecen a la empresa seleccionada
                var filteredCentrosCosto = centrosCostoList.filter(function (item) {
                    return item.Genemp_Id == empresaId; // Comparar con la empresa seleccionada
                });

                // Llenar el dropdown con las centros de costo filtrados
                $.each(filteredCentrosCosto, function (index, item) {
                    $('#centroCostoDropdown').append($('<option>').val(item.Gencencos_Id).text(item.Gencencos_Codigo + ' - ' + item.Gencencos_Descripcion));
                });
            }
        });

        // Eventos adicionales para limpiar tabla cuando se cambien los filtros
        $('#centroCostoDropdown').on('change', function () {
            // Si se deselecciona el centro de costo, limpiar tabla
            if (!$(this).val() || $(this).val() === '') {
                clearTableOnFilterChange();
            }
        });

        $('#numeroSemanaDropdown').on('change', function () {
            // Si se deselecciona la semana, limpiar tabla
            if (!$(this).val() || $(this).val() === '') {
                clearTableOnFilterChange();
            }
        });

        // JavaScript para el modal de informes
        // Abrir modal al clickear el boton Informe
        $('#btnInforme').on('click', function (e) {
            e.preventDefault();
            $('#informeModal').modal('show');
        });

        // Cerrar modal (existe el atributo data-bs-dismiss, esto es adicional)
        $('#btnCerrarInforme').on('click', function () {
            $('#informeModal').modal('hide');
        });

        // Mostrar/ocultar opciones de horas extras segun el tipo seleccionado
        $('#informeTipo').on('change', function () {
            var tipo = $(this).val();
            if (tipo === 'horas_extras_atrasos') {
                $('#opcionesHorasExtras').slideDown(300);
                $('#campoFechas').slideDown(300);
                $('#campoPeriodo').slideUp(300);
            } else if (tipo === 'general_mensual' || tipo === 'validacion_mensual') {
                $('#opcionesHorasExtras').slideUp(300);
                $('#campoFechas').slideUp(300);
                $('#campoPeriodo').slideDown(300);
            } else {
                $('#opcionesHorasExtras').slideUp(300);
                $('#campoFechas').slideDown(300);
                $('#campoPeriodo').slideUp(300);
            }
        });

        // Inicializar estado de opciones al abrir modal
        $('#informeModal').on('shown.bs.modal', function () {
            if ($('#informeTipo').val() === 'horas_extras_atrasos') {
                $('#opcionesHorasExtras').show();
            } else {
                $('#opcionesHorasExtras').hide();
            }
        });

        // Generar informe - enviar al controller
        $('#btnGenerarInforme').on('click', function () {
            var centro = $('#informeCentroCosto').val();
            var fecIni = $('#informeFechaInicio').val();
            var fecFin = $('#informeFechaFin').val();
            var tipo = $('#informeTipo').val();

            // Validacion de tipo de informe seleccionado
            if (!tipo) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Campo requerido',
                    text: 'Debe seleccionar un tipo de informe.',
                    confirmButtonText: 'Aceptar'
                });
                return;
            }

            // Validaciones
            if (!centro) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Campo requerido',
                    text: 'Seleccione un Centro de Costo.'
                });
                return;
            }

            // Validar fechas o periodo segun el tipo de informe
            var periodo = null;
            if (tipo === 'general_mensual' || tipo === 'validacion_mensual') {
                periodo = $('#informePeriodo').val();
                if (!periodo) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Campo requerido',
                        text: 'Seleccione un periodo (YYYY-MM).'
                    });
                    return;
                }
                // Validar formato del periodo
                var [year, month] = periodo.split('-');
                var yearNum = parseInt(year);
                var monthNum = parseInt(month);
                if (isNaN(yearNum) || isNaN(monthNum) || yearNum < 1900 || yearNum > 2100 || monthNum < 1 || monthNum > 12) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Periodo inválido',
                        text: 'El periodo debe ser un año y mes válido (YYYY-MM).'
                    });
                    return;
                }
                // Para informes mensuales, el periodo se envia como string
                // No se necesitan fechas de inicio y fin
            } else if (!fecIni || !fecFin) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Campos requeridos',
                    text: 'Seleccione Fecha Inicio y Fecha Fin.'
                });
                return;
            }
            if (new Date(fecIni) > new Date(fecFin)) {
                Swal.fire({
                    icon: 'error',
                    title: 'Fechas incorrectas',
                    text: 'La Fecha Inicio no puede ser posterior a la Fecha Fin.'
                });
                return;
            }

            // Preparar tipos de informe
            var tiposInformeArray = [];
            
            if (tipo === 'horas_extras_atrasos') {
                if ($('#toggleHE50').is(':checked')) {
                    tiposInformeArray.push({ TipoInforme: 1, Descripcion: "HE50" });
                }
                if ($('#toggleHE100').is(':checked')) {
                    tiposInformeArray.push({ TipoInforme: 2, Descripcion: "HE100" });
                }
                if ($('#toggleAtraso').is(':checked')) {
                    tiposInformeArray.push({ TipoInforme: 3, Descripcion: "Atrasos" });
                }
                
                if (tiposInformeArray.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Seleccion requerida',
                        text: 'Debe seleccionar al menos una opcion para Horas Extras y Atrasos.'
                    });
                    return;
                }
            } else {
                // Para otros tipos de informe, usar valores por defecto
                switch(tipo) {
                    case 'faltas_permisos':
                        tiposInformeArray.push({ TipoInforme: 4, Descripcion: "Faltas y Permisos" });
                        break;
                    case 'general_mensual':
                        tiposInformeArray.push({ TipoInforme: 5, Descripcion: "General Mensual" });
                        break;
                    case 'validacion_mensual':
                        tiposInformeArray.push({ TipoInforme: 6, Descripcion: "Validacion Mensual" });
                        break;
                }
            }

            // Mostrar loading
            Swal.fire({
                title: 'Generando Informe',
                text: 'Por favor espere...',
                icon: 'info',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Formatear fechas en formato yyyy-MM-dd
            function formatDate(dateString) {
                if (!dateString) return '';
                var date = new Date(dateString);
                var year = date.getFullYear();
                var month = String(date.getMonth() + 1).padStart(2, '0');
                var day = String(date.getDate()).padStart(2, '0');
                return year + '-' + month + '-' + day;
            }

            // Obtener email del usuario antes de enviar
            $.ajax({
                url: '@Url.Action("ObtenerDatosUsuario", "PlanillaAsistencia")',
                type: 'GET',
                success: function (emailResponse) {
                    if (!emailResponse.success || !emailResponse.email) {
                        Swal.close();
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'No se pudo obtener el email del usuario. Por favor, inicie sesion nuevamente.',
                            confirmButtonText: 'Aceptar'
                        });
                        return;
                    }

                    // Obtener descripción del centro de costo seleccionado
                    var centroCostoDescripcion = $('#informeCentroCosto option:selected').text();

                    // Construir objeto de datos segun el tipo de informe
                    var datosInforme = {
                        Email: emailResponse.email,
                        CentroCosto: parseInt(centro),
                        CentroCostoDescripcion: centroCostoDescripcion,
                        UsuarioGenera: emailResponse.usuario,
                        TiposInforme: tiposInformeArray
                    };

                    // Para informes mensuales (5 y 6), enviar solo Periodo
                    if (periodo) {
                        datosInforme.Periodo = periodo;
                    } else {
                        // Para otros informes, enviar fechas
                        datosInforme.FechaInicio = formatDate(fecIni);
                        datosInforme.FechaTermino = formatDate(fecFin);
                    }

                    // Enviar datos al controller usando el modelo Rh_Informe_Asistencia
                    $.ajax({
                        url: '@Url.Action("GeneraInforme", "PlanillaAsistencia")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(datosInforme),
                        success: function (response) {
                            Swal.close();
                            
                            if (response.Estado === 'OK') {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Exito',
                                    text: response.Mensaje,
                                    confirmButtonText: 'Aceptar'
                                });
                                $('#informeModal').modal('hide');
                            } else if (response.Estado === 'WARNING') {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Advertencia',
                                    text: response.Mensaje,
                                    confirmButtonText: 'Aceptar'
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: response.Mensaje || 'Ocurrio un error al generar el informe.',
                                    confirmButtonText: 'Aceptar'
                                });
                            }
                        },
                        error: function (xhr, status, error) {
                            Swal.close();
                            
                            var mensaje = 'Error de conexion. Por favor, intente nuevamente.';
                            if (xhr.responseJSON && xhr.responseJSON.Mensaje) {
                                mensaje = xhr.responseJSON.Mensaje;
                            }
                            
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: mensaje,
                                confirmButtonText: 'Aceptar'
                            });
                        }
                    });
                },
                error: function (xhr, status, error) {
                    Swal.close();
                    console.error('Error al obtener email del usuario:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error de sesion',
                        text: 'No se pudo obtener la informacion del usuario. Por favor, inicie sesion nuevamente.',
                        confirmButtonText: 'Aceptar'
                    });
                }
            });
        });

        // Event handler para cerrar modal de glosario
        $('#glosario [data-bs-dismiss="modal"]').on('click', function () {
            $('#glosario').modal('hide');
        });
    });
</script>

<!-- GLOSARIO MODERNIZADO -->
<div class="modal fade" id="glosario" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg col-10 mx-auto" role="document">
        <div class="modal-content" style="border-radius: 15px; border: none; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #5E9217, #4A7613); color: white; border-radius: 15px 15px 0 0; border-bottom: none; padding: 1.25rem;">
                <h5 class="modal-title" id="exampleModal3Label" style="color: white; font-weight: 600; margin: 0;">
                    <i class="bi bi-book me-2"></i>Glosario de Conceptos
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 1rem; background: linear-gradient(135deg, #f8f9fa, #e9ecef); max-height: 70vh; overflow-y: auto;">
                <div class="table-responsive" style="max-height: 60vh;">
                    <table id="tablaGlosario" class="table table-hover glosario-table table-sm" style="width: 100%; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 0;">
                        <thead style="background: linear-gradient(135deg, #5E9217, #4A7613); color: white; position: sticky; top: 0; z-index: 10;">
                            <tr>
                                <th style="padding: 8px 12px; font-weight: 600; border: none; font-size: 14px;">
                                    <i class="bi bi-tags me-1"></i>Sigla
                                </th>
                                <th style="padding: 8px 12px; font-weight: 600; border: none; font-size: 14px;">
                                    <i class="bi bi-card-text me-1"></i>Descripcion
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (lstAsistenciaConceptosVisibles != null && lstAsistenciaConceptosVisibles.Count > 0)
                            {
                                foreach (var conceptoVisible in lstAsistenciaConceptosVisibles)
                                {
                                    <tr class="glosario-row" style="transition: all 0.2s ease; background-color: white;">
                                        <td style="padding: 8px 12px; border: 1px solid #e9ecef; vertical-align: middle; text-align: center;">
                                            @conceptoVisible.Rhasicon_Sigla
                                        </td>
                                        <td style="padding: 8px 12px; color: #495057; border: 1px solid #e9ecef; vertical-align: middle; font-size: 13px;">
                                            @conceptoVisible.Rhasicon_Descripcion
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <!-- Conceptos básicos de ejemplo si no están disponibles del controller -->
                                <tr class="glosario-row" style="transition: all 0.2s ease; background-color: white;">
                                    <td style="padding: 8px 12px; border: 1px solid #e9ecef; vertical-align: middle; text-align: center;">
                                        P
                                    </td>
                                    <td style="padding: 8px 12px; color: #495057; border: 1px solid #e9ecef; vertical-align: middle; font-size: 13px;">
                                        Presente
                                    </td>
                                </tr>
                                <tr class="glosario-row" style="transition: all 0.2s ease; background-color: white;">
                                    <td style="padding: 8px 12px; border: 1px solid #e9ecef; vertical-align: middle; text-align: center;">
                                        A
                                    </td>
                                    <td style="padding: 8px 12px; color: #495057; border: 1px solid #e9ecef; vertical-align: middle; font-size: 13px;">
                                        Ausente
                                    </td>
                                </tr>
                                <tr class="glosario-row" style="transition: all 0.2s ease; background-color: white;">
                                    <td style="padding: 8px 12px; border: 1px solid #e9ecef; vertical-align: middle; text-align: center;">
                                        V
                                    </td>
                                    <td style="padding: 8px 12px; color: #495057; border: 1px solid #e9ecef; vertical-align: middle; font-size: 13px;">
                                        Vacaciones
                                    </td>
                                </tr>
                                <tr class="glosario-row" style="transition: all 0.2s ease; background-color: white;">
                                    <td style="padding: 8px 12px; border: 1px solid #e9ecef; vertical-align: middle; text-align: center;">
                                        LS
                                    </td>
                                    <td style="padding: 8px 12px; color: #495057; border: 1px solid #e9ecef; vertical-align: middle; font-size: 13px;">
                                        Licencia por Salud
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="padding: 15px; text-align: center; color: #6c757d; font-style: italic; background-color: #f8f9fa;">
                                        <i class="bi bi-info-circle me-2"></i>Para ver el glosario completo, realice una búsqueda primero
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #e9ecef; padding: 1.25rem; background: #f8f9fa;">
                <button type="button" class="btn btn-modern-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cerrar
                </button>
            </div>
        </div>
    </div>
</div>
