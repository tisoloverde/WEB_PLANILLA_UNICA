@model IEnumerable<Object>
@{
    List<PlanillaUnicaWeb.Models.Gen_Empresa> lstEmpresa = Model.ToList()[0] as List<PlanillaUnicaWeb.Models.Gen_Empresa>;
    List<PlanillaUnicaWeb.Models.Gen_Centro_Costo> lstCentroCosto = Model.ToList()[1] as List<PlanillaUnicaWeb.Models.Gen_Centro_Costo>;
    List<PlanillaUnicaWeb.Models.Gen_Ano> lstAno = Model.ToList()[2] as List<PlanillaUnicaWeb.Models.Gen_Ano>;
    PlanillaUnicaWeb.Models.FiltroPlanilla filtroPlanilla = Model.ToArray()[3] as PlanillaUnicaWeb.Models.FiltroPlanilla;


    string classAlerta = string.Empty;

    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@{ Html.EnableClientValidation(true);
    Html.EnableUnobtrusiveJavaScript(true); }

<style>
    th, td {
        white-space: nowrap;
    }

    div.dataTables_wrapper {
        margin: 0 auto;
    }

    div.container {
        width: 80%;
    }

</style>

<script>
    $(document).ready(function (e) {

        $('#tablaPlanilla').DataTable(
            {
                "scrollY": 540,
                "paging": false,
                "language": {
                    "lengthMenu": "Motrar _MENU_ registros por página",
                    "zeroRecords": "Sin información",
                    "search": "Buscar:",
                    "info": "Mostrando _START_ a _END_ de un total de _TOTAL_ Registros",
                    "infoEmpty": "Sin información disponible",
                    "infoFiltered": "(filtered from _MAX_ total records)",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "paginate": {
                        "first": "Primero",
                        "last": "Ultimo",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            }
        );

        // Evento change para el select de periodos
        $('#periodoDropdown').on('change', async function () {
            $('#loader').fadeIn(300);
            const periodo = $(this).val();

            let semanaActivaEncontrada = false;

            $('#numeroSemanaDropdown').empty();
            $('#numeroSemanaDropdown').append($('<option>').val('').text('-- Seleccione Semana --'));

            if (periodo) {
                try {
                    const response = await $.ajax({
                        url: '@Url.Action("BuscaSemanasPeriodo", "PlanillaAsistencia")',
                        type: 'GET',
                        data: { periodo: periodo },
                        dataType: 'json',
                        timeout: 10000
                    });

                    if (!response || !response.data || !Array.isArray(response.data)) {
                        throw new Error('Respuesta del servidor inválida');
                    }

                    response.data.forEach(p => {
                        if (p.Activa) {
                            $('#numeroSemanaDropdown').append(
                                `<option value="${p.NumeroSemana}"
                                 data-fecini="${p.FechaInicioSemana}"
                                 data-fecfin="${p.FechaFinSemana}" selected>
                                 Semana ${p.NumeroSemana} del ${p.Ano} ( ${p.FechaInicioSemana} al ${p.FechaFinSemana} )
                                 </option>`
                            );
                            $('#filtroPlanilla_FechaInicio').val(p.FechaInicioSemana);
                            $('#filtroPlanilla_FechaTermino').val(p.FechaFinSemana);
                            semanaActivaEncontrada = true;
                        } else {
                            $('#numeroSemanaDropdown').append(
                                `<option value="${p.NumeroSemana}"
                                 data-fecini="${p.FechaInicioSemana}"
                                 data-fecfin="${p.FechaFinSemana}">
                                 Semana ${p.NumeroSemana} del ${p.Ano} ( ${p.FechaInicioSemana} al ${p.FechaFinSemana} )
                                 </option>`
                            );
                        }
                    });

                    if (semanaActivaEncontrada) {
                        // Opción 1: Submit directo del formulario
                        autoSubmitForm();

                    }                                                        

                } catch (error) {
                    console.error('Error detallado:', error);

                    let errorMessage = 'Error cargando semanas';
                    if (error.status) {
                        errorMessage += ` (Status: ${error.status})`;
                    }

                    alert(errorMessage);
                }
            }
        });

        setTimeout(function () {
            $(".content").fadeOut(1500);
        }, 3000);

    });
       

    function autoSubmitForm() {
        const selectCentroCosto = document.getElementById('centroCostoDropdown');
        const selectPeriodo = document.getElementById('periodoDropdown');
        const selectSemana = document.getElementById('numeroSemanaDropdown');

        if ((selectCentroCosto.value && selectCentroCosto.value !== '') &&
            (selectPeriodo.value && selectPeriodo.value !== '') &&
            (selectSemana.value && selectSemana.value !== '')) {
            // Submit automático
            document.getElementById('autoSubmitForm').submit();
        }
    }

</script>


<div class="row mx-auto" style="width: 170vh;">
    <div class="card-body">
        @using (Html.BeginForm("Cargar", "PlanillaAsistencia", null, FormMethod.Post, new { id = "autoSubmitForm" } ))
        {
            <div class="row mx-auto">
                <div class="col-md-12 mx-auto">
                    <h4 class="personalizado" style="text-align:left;"><i class="bi bi-box-arrow-right"></i>&nbsp;Planilla Asistencia</h4>
                </div>
            </div>
            <div class="row mx-auto">
                <div class="col-md-12 mt-3 mx-auto">
                    <div class="row">
                        <div class="col-md-3 mt-2 auto">
                            <label>Empresa</label>
                        </div>
                        <div class="col-md-3 mt-2 auto">
                            <label>Centro de Costo</label>
                        </div>
                        <div class="col-md-1 mt-2 auto">
                            <labe>Periodo</labe>
                        </div>
                        <div class="col-md-3 mt-2 auto">
                            <labe>Semana</labe>
                        </div>
                        <div class="col-md-2 mt-2 auto">
                            &nbsp;
                        </div>
                    </div>
                    @Html.HiddenFor(Model => filtroPlanilla.FechaInicio)
                    @Html.HiddenFor(Model => filtroPlanilla.FechaTermino)
                    <div class="row">
                        <div class="col-md-3 mt-1 auto">
                            @Html.DropDownListFor(x => filtroPlanilla.Genemp_Id,
                             new SelectList(lstEmpresa, "Genemp_Id", "Genemp_Descripcion"),
                             "-- Selecciona Empresa --", new { @class = "form-control", id = "empresaDropdown", data_placeholder = "Selecciona Empresa" })
                        </div>
                        <div class="col-md-3 mt-1 auto">
                            @Html.DropDownListFor(x => filtroPlanilla.Gencencos_Id,
                                             new SelectList(Enumerable.Empty<SelectListItem>(), "Gencencos_Id", "Gencencos_Descripcion"),
                                             "-- Seleccione Centro de Costo --",
                                             new { @class = "form-control", id = "centroCostoDropdown", onchange = "autoSubmitForm()" })
                            @Html.ValidationMessageFor(x => filtroPlanilla.Gencencos_Id, null, new { @class = "text-danger" })
                        </div>
                        <div class="col-md-1 mt-1 auto">
                            @Html.DropDownListFor(x => filtroPlanilla.Periodo,
                                            new SelectList(lstAno, "Ano", "Ano"),
                                            "-- Seleccione --",
                                            new { @class = "form-control", id = "periodoDropdown", data_placeholder = "Seleccione" })
                        </div>
                        <div class="col-md-3 mt-1 auto">
                            @Html.DropDownListFor(x => filtroPlanilla.NumeroSemana,
                                            new SelectList(Enumerable.Empty<SelectListItem>(), "NumeroSemana", "DescripcionSemana"),
                                            "-- Seleccione Semana --",
                                            new { @class = "form-control", id = "numeroSemanaDropdown" })
                        </div>
                        <div class="col-md-2 mt-1 auto">
                            <input type="submit" class="btn btn-primary float-left px-4" value="Buscar" style="display: none;">
                        </div>
                    </div>
                </div>
            </div>
        }

        <br />

        <div class="row mx-auto">
            <div class="col-12">
                <table id="tablaPlanilla" class="table table-bordered table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th colspan="8">Datos Generales</th>
                            <th colspan="4">Información en Terreno</th>
                            <th colspan="1">Reemplazo</th>
                            <th colspan="3">Fechas</th>
                            <th colspan="12">Asistencia</th>
                        </tr>
                        <tr>
                            <th></th>
                            <th>RUT</th>
                            <th>Apellidos y Nombres</th>
                            <th>Cargo Liquidación</th>
                            <th>cargo Genérico</th>
                            <th>JEAS</th>
                            <th>REF1</th>
                            <th>REF2</th>
                            <th>Cargo Genérico</th>
                            <th>JEAS</th>
                            <th>REF1</th>
                            <th>REF2</th>
                            <th>RUT</th>
                            <th>Fecha Ingreso</th>
                            <th>Fecha Término</th>
                            <th>Nro. de Contrato</th>
                            @*<th>Temporal</th>*@
                            <th class="header-with-day">
                                <span class="day-label">Lu</span>
                            </th>
                            <th class="header-with-day">
                                <span class="day-label">Ma</span>
                            </th>
                            <th class="header-with-day">
                                <span class="day-label">Mi</span>
                            </th>
                            <th class="header-with-day">
                                <span class="day-label">Ju</span>
                            </th>
                            <th class="header-with-day">
                                <span class="day-label">Vi</span>
                            </th>
                            <th class="header-with-day">
                                <span class="day-label">Sá</span>
                            </th>
                            <th class="header-with-day">
                                <span class="day-label">Do</span>
                            </th>
                            <th>Días</th>
                            <th>HE50</th>
                            <th>HE100</th>
                            <th>Atraso</th>
                            <th>Observación</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>




    </div>
</div>

<script>

    var centrosCostoList = @Html.Raw(Json.Encode(lstCentroCosto));

    $(document).ready(function () {
        // Cuando se seleccione una empresa para cargar los centros de costo asociados
        $('#empresaDropdown').change(function () {
            var table = $('#tablaPlanilla').DataTable();
            table.clear().draw();

            var empresaId = $(this).val(); // Obtener el ID de la empresa

            // Limpiar el dropdown de centros de costo
            $('#centroCostoDropdown').empty();
            $('#centroCostoDropdown').append($('<option>').val('').text('-- Seleccione Centro de Costo --')); // Opción por defecto

            // Si hay una empresa seleccionada
            if (empresaId) {
                // Filtrar los centros de costo que pertenecen a la empresa seleccionada
                var filteredCentrosCosto = centrosCostoList.filter(function (item) {
                    return item.Genemp_Id == empresaId; // Comparar con la empresa seleccionada
                });

                // Llenar el dropdown con las centros de costo filtrados
                $.each(filteredCentrosCosto, function (index, item) {
                    $('#centroCostoDropdown').append($('<option>').val(item.Gencencos_Id).text(item.Gencencos_Codigo + ' - ' + item.Gencencos_Descripcion));
                });
            }
        });
    });
</script>