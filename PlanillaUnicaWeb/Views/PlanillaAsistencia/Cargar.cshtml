        left: 0px;
        z-index: 10;
        background-color: white;
        border-right: 2px solid #dee2e6;
        min-width: 50px;
        max-width: 50px;
        width: 50px;
    }

    /* COLUMNAS FIJAS - Segunda columna (RUT) */
    #tablaPlanilla th:nth-child(2),
    #tablaPlanilla td:nth-child(2) {
        position: -webkit-sticky;
        position: sticky;
        left: 50px;
        z-index: 10;
        background-color: white;
        border-right: 2px solid #dee2e6;
        min-width: 120px;
        max-width: 120px;
        width: 120px;
    }

    /* COLUMNAS FIJAS - Tercera columna (Apellidos y Nombres) */
    #tablaPlanilla th:nth-child(3),
    #tablaPlanilla td:nth-child(3) {
        position: -webkit-sticky;
        position: sticky;
        left: 170px;
        z-index: 10;
        background-color: white;
        border-right: 3px solid #007bff;
        min-width: 250px;
        max-width: 250px;
        width: 250px;
        box-shadow: 2px 0 5px rgba(0,0,0,0.1);
    }

    /* Headers de las columnas fijas */
    #tablaPlanilla thead th:nth-child(1),
    #tablaPlanilla thead th:nth-child(2),
    #tablaPlanilla thead th:nth-child(3) {
        z-index: 11;
        background-color: #f8f9fa;
        font-weight: bold;
    }

    /* Ajustar el ancho de las columnas restantes */
    #tablaPlanilla th:nth-child(n+4),
    #tablaPlanilla td:nth-child(n+4) {
        min-width: 120px;
        white-space: nowrap;
    }

    /* Especifico para columnas de dias */
    #tablaPlanilla th:nth-child(17),
    #tablaPlanilla th:nth-child(18),
    #tablaPlanilla th:nth-child(19),
    #tablaPlanilla th:nth-child(20),
    #tablaPlanilla th:nth-child(21),
    #tablaPlanilla th:nth-child(22),
    #tablaPlanilla th:nth-child(23),
    #tablaPlanilla td:nth-child(17),
    #tablaPlanilla td:nth-child(18),
    #tablaPlanilla td:nth-child(19),
    #tablaPlanilla td:nth-child(20),
    #tablaPlanilla td:nth-child(21),
    #tablaPlanilla td:nth-child(22),
    #tablaPlanilla td:nth-child(23) {
        min-width: 80px;
        width: 80px;
    }

    /* Asegurar que los headers de grupo no interfieran */
    #tablaPlanilla thead tr:first-child th {
        background-color: #f8f9fa !important;
        font-weight: bold;
        border-bottom: 2px solid #dee2e6;
    }

        /* Correccion para headers con colspan */
        #tablaPlanilla thead tr:first-child th:nth-child(1) {
            position: sticky;
            left: 0px;
            z-index: 12;
            min-width: 420px; /* Suma de las 3 primeras columnas */
            width: 420px;
        }

    #btnGuardarAsistencia:disabled {
        opacity: 0.6 !important;
        cursor: not-allowed !important;
        background-color: #6c757d !important;
        border-color: #6c757d !important;
    }

    /* Estilos basicos para etiquetas con iconos */
    .label-with-icon {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: #365A0F;
        margin-bottom: 5px;
    }

    .label-with-icon i {
        font-size: 16px;
        color: #5E9217;
        transition: all 0.3s ease;
    }

    /* Efectos hover simples */
    .label-with-icon:hover i {
        color: #4A7613;
        transform: scale(1.1);
    }

    .btn i {
        transition: all 0.3s ease;
    }

    /* Botones estilo modal dotacion */
    .btn-modern-success {
        background: linear-gradient(135deg, #5E9217, #4A7613) !important;
        border: none !important;
        border-radius: 8px !important;
        padding: 8px 20px !important;
        color: white !important;
        font-weight: 600 !important;
    }

    .btn-modern-secondary {
        background: transparent !important;
        border: 1px solid #6c757d !important;
        border-radius: 8px !important;
        padding: 8px 20px !important;
        color: #6c757d !important;
        font-weight: 600 !important;
    }

    .btn-modern-secondary:hover {
        background: #6c757d !important;
        color: white !important;
    }

    .btn:hover i {
        transform: scale(1.05);
    }

    /* Estilos Especificos para el modal de glosario compacto */
    .glosario-table tbody .glosario-row {
        transition: all 0.2s ease;
        background-color: white;
        height: 40px;
    }

    .glosario-table tbody .glosario-row:hover {
        background-color: #f8f9fa !important;
        transform: scale(1.01);
        cursor: pointer;
    }



    /* Scroll suave para el glosario */
    .modal-body::-webkit-scrollbar {
        width: 6px;
    }

    .modal-body::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 3px;
    }

    .modal-body::-webkit-scrollbar-thumb {
        background: #5E9217;
        border-radius: 3px;
    }

    .modal-body::-webkit-scrollbar-thumb:hover {
        background: #4A7613;
    }





</style>



<script>
    $(document).ready(function (e) {

        // Inicializar estado del botón guardar
        verificarBotonGuardar();

        $('.fila-checkbox').each(function () {
            this.checked = false;
            // Quitar estilos si los tiene
            const $row = $(this).closest('tr');
            $row.removeClass('fila-seleccionada-checkbox');
            $row.children('td, th').css({
                'background-color': '',
                'color': ''
            });
            $row.find('select, input').css({
                'background-color': '',
                'color': '',
                'border': ''
            });
        });


        $('#tablaPlanilla').DataTable(
            {
                "scrollY": 540,
                "scrollX": true,
                "paging": false,
                "scrollCollapse": true,
                // NUEVAS OPCIONES PARA MANTENER alineacion:
                "autoWidth": false,
                "columnDefs": [
                    {
                        "targets": "_all",
                        "className": "text-center"
                    }
                ],
                "drawCallback": function (settings) {
                    // Aplicar colores despues de redraw
                    setTimeout(function () {
                        $('.fila-checkbox:checked').each(function () {
                            aplicarColorFila(this, true);
                        });

                        // Verificar estado del botón guardar
                        verificarBotonGuardar();

                        // Ajustar columnas
                        var table = $('#tablaPlanilla').DataTable();
                        table.columns.adjust();
                    }, 50);
                },
                "initComplete": function (settings, json) {
                    // Ajuste inicial
                    setTimeout(function () {
                        var table = $('#tablaPlanilla').DataTable();
                        table.columns.adjust();
                    }, 200);
                },
                "language": {
                    "lengthMenu": "Mostrar _MENU_ registros por pagina",
                    "zeroRecords": "Sin informacion",
                    "search": "Buscar:",
                    "info": "Mostrando _START_ a _END_ de un total de _TOTAL_ Registros",
                    "infoEmpty": "Sin informacion disponible",
                    "infoFiltered": "(filtered from _MAX_ total records)",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "paginate": {
                        "first": "Primero",
                        "last": "Ultimo",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                },
                "layout": {
                    topStart: {
                        buttons: [
                            {
                                text: 'Seleccionar todo',
                                className: 'btn btn-info',
                                action: function (e, dt, button, config) {
                                    // MEJORADO: Usar API de DataTable en lugar de DOM directo
                                    dt.rows().every(function () {
                                        const row = this.node();
                                        const checkbox = $(row).find('.fila-checkbox')[0];

                                        const selectLun = $(row).find('.selectLun')[0];
                                        const selectMar = $(row).find('.selectMar')[0];
                                        const selectMie = $(row).find('.selectMie')[0];
                                        const selectJue = $(row).find('.selectJue')[0];
                                        const selectVie = $(row).find('.selectVie')[0];
                                        const selectSab = $(row).find('.selectSab')[0];
                                        const selectDom = $(row).find('.selectDom')[0];

                                        if (checkbox) {
                                            checkbox.checked = true;
                                            aplicarColorFila(checkbox, true);
                                        }

                                        if (selectLun) {
                                            if (selectLun.value == '0') { selectLun.value = '21'; $(selectLun).trigger('change'); }
                                        }
                                        if (selectMar) {
                                            if (selectMar.value == '0') { selectMar.value = '21'; $(selectMar).trigger('change'); }
                                        }
                                        if (selectMie) {
                                            if (selectMie.value == '0') { selectMie.value = '21'; $(selectMie).trigger('change'); }
                                        }
                                        if (selectJue) {
                                            if (selectJue.value == '0') { selectJue.value = '21'; $(selectJue).trigger('change'); }
                                        }
                                        if (selectVie) {
                                            if (selectVie.value == '0') { selectVie.value = '21'; $(selectVie).trigger('change'); }
                                        }
                                        if (selectSab) {
                                            if (selectSab.value == '0') { selectSab.value = '21'; $(selectSab).trigger('change'); }
                                        }
                                        if (selectDom) {
                                            if (selectDom.value == '0') { selectDom.value = '21'; $(selectDom).trigger('change'); }
                                        }

                                        $(row).children('td, th').css('background-color', '#36ACC4');
                                        $(row).children('td, th').css('color', 'white');
                                    });

                                    setTimeout(verificarBotonGuardar, 100);
                                }
                            },
                            {
                                text: 'Deseleccionar todo',
                                className: 'btn btn-info',
                                action: function (e, dt, button, config) {
                                    // MEJORADO: Usar API de DataTable en lugar de DOM directo
                                    dt.rows().every(function () {
                                        const row = this.node();
                                        const checkbox = $(row).find('.fila-checkbox')[0];
                                        const selectLun = $(row).find('.selectLun')[0];
                                        const selectMar = $(row).find('.selectMar')[0];
                                        const selectMie = $(row).find('.selectMie')[0];
                                        const selectJue = $(row).find('.selectJue')[0];
                                        const selectVie = $(row).find('.selectVie')[0];
                                        const selectSab = $(row).find('.selectSab')[0];
                                        const selectDom = $(row).find('.selectDom')[0];

                                        if (checkbox) {
                                            checkbox.checked = false;
                                            aplicarColorFila(checkbox, false);
                                        }

                                        if (selectLun) {
                                            if (selectLun.value == '21') { selectLun.value = '0'; $(selectLun).trigger('change'); }
                                        }
                                        if (selectMar) {
                                            if (selectMar.value == '21') { selectMar.value = '0'; $(selectMar).trigger('change'); }
                                        }
                                        if (selectMie) {
                                            if (selectMie.value == '21') { selectMie.value = '0'; $(selectMie).trigger('change'); }
                                        }
                                        if (selectJue) {
                                            if (selectJue.value == '21') { selectJue.value = '0'; $(selectJue).trigger('change'); }
                                        }
                                        if (selectVie) {
                                            if (selectVie.value == '21') { selectVie.value = '0'; $(selectVie).trigger('change'); }
                                        }
                                        if (selectSab) {
                                            if (selectSab.value == '21') { selectSab.value = '0'; $(selectSab).trigger('change'); }
                                        }
                                        if (selectDom) {
                                            if (selectDom.value == '21') { selectDom.value = '0'; $(selectDom).trigger('change'); }
                                        }

                                        $(row).children('td, th').css('background-color', 'white');
                                        $(row).children('td, th').css('color', 'black');
                                    });

                                    setTimeout(verificarBotonGuardar, 100);

                                }
                            },
                            {
                                text: 'Glosario',
                                className: 'btn btn-info',
                                action: function (e, dt, button, config) {
                                    $('#glosario').modal('show');
                                }
                            }
                        ]
                    }
                }
            }
        );

        $('#periodoDropdown').on('change', async function () {
            // Limpiar tabla inmediatamente cuando cambia el periodo
            clearTableOnFilterChange();
            
            $('#loader').fadeIn(300);
            const periodo = $(this).val();

            let semanaActivaEncontrada = false;

            $('#numeroSemanaDropdown').empty();
            $('#numeroSemanaDropdown').append($('<option>').val('').text('-- Seleccione Semana --'));

            if (periodo) {
                try {
                    const response = await $.ajax({
                        url: '@Url.Action("BuscaSemanasPeriodo", "PlanillaAsistencia")',
                        type: 'GET',
                        data: { periodo: periodo },
                        dataType: 'json',
                        timeout: 10000
                    });

                    if (!response || !response.data || !Array.isArray(response.data)) {
                        throw new Error('Respuesta del servidor invalida');
                    }

                    response.data.forEach(p => {
                        if (p.Activa) {
                            $('#numeroSemanaDropdown').append(
                                `<option value="${p.NumeroSemana}"
                                 data-fecini="${p.FechaInicioSemana}"
                                 data-fecfin="${p.FechaFinSemana}" selected>
                                 Semana ${p.NumeroSemana} del ${p.Ano} ( ${p.FechaInicioSemana} al ${p.FechaFinSemana} )
                                 </option>`
                            );
                            $('#filtroPlanilla_FechaInicio').val(p.FechaInicioSemana);
                            $('#filtroPlanilla_FechaTermino').val(p.FechaFinSemana);
                            semanaActivaEncontrada = true;
                        } else {
                            $('#numeroSemanaDropdown').append(
                                `<option value="${p.NumeroSemana}"
                                 data-fecini="${p.FechaInicioSemana}"
                                 data-fecfin="${p.FechaFinSemana}">
                                 Semana ${p.NumeroSemana} del ${p.Ano} ( ${p.FechaInicioSemana} al ${p.FechaFinSemana} )
                                 </option>`
                            );
                        }
                    });


                    if (semanaActivaEncontrada) {
                        // Opcion 1: Submit directo del formulario
                        autoSubmitForm();
                    }

                } catch (error) {
                    console.error('Error detallado:', error);

                    let errorMessage = 'Error cargando semanas';
                    if (error.status) {
                        errorMessage += ` (Status: ${error.status})`;
                    }

                    alert(errorMessage);
                }
            }
        });

        // Evento change para el select de semanas
        $('#numeroSemanaDropdown').change(function () {
            $('#loader').fadeIn(300);
            const opcionSeleccionada = $(this).find('option:selected');
            const fechaIni = opcionSeleccionada.data('fecini');
            const fechaFin = opcionSeleccionada.data('fecfin');
            asignarYEnviar(fechaIni, fechaFin);
        });


        // Evento click para el boton de grabar asistencia
        $('#numeroSemanaDropdown').change(function () {
            $('#loader').fadeIn(300);
            const opcionSeleccionada = $(this).find('option:selected');
            const fechaIni = opcionSeleccionada.data('fecini');
            const fechaFin = opcionSeleccionada.data('fecfin');
            asignarYEnviar(fechaIni, fechaFin);
        });


        $('#glosario [data-bs-dismiss="modal"]').on('click', function () {
            $('#glosario').modal('hide');
        });

        // FUNCION PARA COLOREAR FILAS
        function aplicarColorFila(checkbox, activar) {
            const $row = $(checkbox).closest('tr');

            if (activar) {
                $row.addClass('fila-seleccionada-checkbox');

                // Solo aplicar colores, NO cambiar dimensiones
                $row.children('td, th').css({
                    'background-color': '#36ACC4',
                    'color': 'white',
                });

                // NUEVO: Asignar valores por defecto a los selects de dias
                const selectLun = $row.find('.selectLun')[0];
                const selectMar = $row.find('.selectMar')[0];
                const selectMie = $row.find('.selectMie')[0];
                const selectJue = $row.find('.selectJue')[0];
                const selectVie = $row.find('.selectVie')[0];
                const selectSab = $row.find('.selectSab')[0];
                const selectDom = $row.find('.selectDom')[0];

                // Asignar valor '21' si el select esta vacio
                if (selectLun && selectLun.value == '0') {
                    selectLun.value = '21';
                    $(selectLun).trigger('change');
                }
                if (selectMar && selectMar.value == '0') {
                    selectMar.value = '21';
                    $(selectMar).trigger('change');
                }
                if (selectMie && selectMie.value == '0') {
                    selectMie.value = '21';
                    $(selectMie).trigger('change');
                }
                if (selectJue && selectJue.value == '0') {
                    selectJue.value = '21';
                    $(selectJue).trigger('change');
                }
                if (selectVie && selectVie.value == '0') {
                    selectVie.value = '21';
                    $(selectVie).trigger('change');
                }
                if (selectSab && selectSab.value == '0') {
                    selectSab.value = '21';
                    $(selectSab).trigger('change');
                }
                if (selectDom && selectDom.value == '0') {
                    selectDom.value = '21';
                    $(selectDom).trigger('change');
                }

                $row.find('select, input').css({
                    'background-color': 'white',
                    'color': 'black',
                    'border': '2px solid #36ACC4'
                });

            } else {
                $row.removeClass('fila-seleccionada-checkbox');

                // NUEVO: Limpiar valores por defecto de los selects de dias
                const selectLun = $row.find('.selectLun')[0];
                const selectMar = $row.find('.selectMar')[0];
                const selectMie = $row.find('.selectMie')[0];
                const selectJue = $row.find('.selectJue')[0];
                const selectVie = $row.find('.selectVie')[0];
                const selectSab = $row.find('.selectSab')[0];
                const selectDom = $row.find('.selectDom')[0];

                // Limpiar valor '21' si esta seleccionado
                if (selectLun && selectLun.value == '21') {
                    selectLun.value = '0';
                    $(selectLun).trigger('change');
                }
                if (selectMar && selectMar.value == '21') {
                    selectMar.value = '0';
                    $(selectMar).trigger('change');
                }
                if (selectMie && selectMie.value == '21') {
                    selectMie.value = '0';
                    $(selectMie).trigger('change');
                }
                if (selectJue && selectJue.value == '21') {
                    selectJue.value = '0';
                    $(selectJue).trigger('change');
                }
                if (selectVie && selectVie.value == '21') {
                    selectVie.value = '0';
                    $(selectVie).trigger('change');
                }
                if (selectSab && selectSab.value == '21') {
                    selectSab.value = '0';
                    $(selectSab).trigger('change');
                }
                if (selectDom && selectDom.value == '21') {
                    selectDom.value = '0';
                    $(selectDom).trigger('change');
                }

                $row.children('td, th').css({
                    'background-color': '',
                    'color': '',
                });

                $row.find('select, input').css({
                    'background-color': '',
                    'color': '',
                    'border': ''
                });
            }

            // Ajustar columnas despues del cambio
            setTimeout(function () {
                const table = $('#tablaPlanilla').DataTable();
                table.columns.adjust();
            }, 10);
        }

        // EVENT HANDLER PARA CHECKBOXES
        $(document).on('change', '.fila-checkbox', function () {
            const isChecked = $(this).is(':checked');
            aplicarColorFila(this, isChecked);

            verificarBotonGuardar();

        });

        // MANEJO COMPLETO DE CAMPOS DECIMALES
        function formatearCampoDecimal(elemento) {
            var valor = $(elemento).val();
            if (valor && valor !== '') {
                // Reemplazar coma por punto
                valor = valor.replace(',', '.');
                // Convertir a número
                var numero = parseFloat(valor);
                if (!isNaN(numero) && numero !== 0) {
                    // Solo mostrar decimales si no son .00
                    var valorFormateado = numero % 1 === 0 ? numero.toString() : numero.toFixed(2).replace(/\.?0+$/, '');
                    $(elemento).val(valorFormateado);
                } else if (numero === 0) {
                    // Si es cero, dejar el campo vacio
                    $(elemento).val('');
                }
            }
        }

        // Los valores ya se cargan formateados desde la vista, no necesita formateo adicional

        // Durante la escritura, permitir solo números, puntos y comas
        $(document).on('input', '.decimal-input', function () {
            var valor = $(this).val();
            // Permitir solo números, punto y coma
            valor = valor.replace(/[^0-9.,]/g, '');
            // Permitir solo una coma o punto
            valor = valor.replace(/([.,].*?)[.,]/g, '$1');
            $(this).val(valor);
        });

        // Al salir del campo, formatear correctamente
        $(document).on('blur', '.decimal-input', function () {
            formatearCampoDecimal(this);
        });

        // Antes de enviar el formulario, convertir TODO a formato punto y manejar vacios
        $(document).on('submit', '#formGuardarAsistencia', function (e) {
            $('.decimal-input').each(function () {
                var valor = $(this).val();
                if (valor && valor !== '') {
                    // Convertir coma a punto y asegurar formato numérico
                    valor = valor.replace(',', '.');
                    $(this).val(valor);
                } else {
                    // Si esta vacio, enviar 0 para evitar null en el servidor
                    $(this).val('0');
                }
            });
        });

        setTimeout(function () {
            $(".content").fadeOut(1500);
        }, 3000);

        setTimeout(function () {
            $('.fila-checkbox:checked').each(function () {
                aplicarColorFila(this, true);
            });
        }, 100);

    });

    function verificarBotonGuardar() {
        const checkboxesSeleccionados = $('.fila-checkbox:checked').length;
        const $btnGuardar = $('#btnGuardarAsistencia');

        if (checkboxesSeleccionados > 0) {
            $btnGuardar.prop('disabled', false).removeClass('btn-secondary').addClass('btn-primary');
        } else {
            $btnGuardar.prop('disabled', true).removeClass('btn-primary').addClass('btn-secondary');
        }
    }

    // Evento click para el botón guardar (ahora fuera del formulario)
    $(document).on('click', '#btnGuardarAsistencia', function(e) {
        e.preventDefault();
        if (!$(this).prop('disabled')) {
            $('#formGuardarAsistencia').submit();
        }
    });

    function asignarYEnviar(fechaIni, fechaFin) {

        return new Promise((resolve) => {
            $('#filtroPlanilla_FechaInicio').val(fechaIni);
            $('#filtroPlanilla_FechaTermino').val(fechaFin);

            // Pequeño delay para asegurar que se asigno
            setTimeout(() => {
                //console.log('Valor confirmado:', $('#campoHidden').val());
                resolve();
            }, 20);
        }).then(() => {
            autoSubmitForm();
        });
    }

    function autoSubmitForm() {
        const selectEmpresa = document.getElementById('empresaDropdown');
        const selectCentroCosto = document.getElementById('centroCostoDropdown');
        const selectPeriodo = document.getElementById('periodoDropdown');
        const selectSemana = document.getElementById('numeroSemanaDropdown');

        // Limpiar tabla si falta algún filtro requerido
        if (!selectEmpresa.value || selectEmpresa.value === '' ||
            !selectCentroCosto.value || selectCentroCosto.value === '' ||
            !selectPeriodo.value || selectPeriodo.value === '' ||
            !selectSemana.value || selectSemana.value === '') {
            
            // Limpiar la tabla
            var table = $('#tablaPlanilla').DataTable();
            table.clear().draw();
            return; // No enviar el formulario
        }

        // Solo enviar si todos los filtros están completos
        if ((selectEmpresa.value && selectEmpresa.value !== '') &&
            (selectCentroCosto.value && selectCentroCosto.value !== '') &&
            (selectPeriodo.value && selectPeriodo.value !== '') &&
            (selectSemana.value && selectSemana.value !== '')) {
            // Submit automatico
            document.getElementById('autoSubmitForm').submit();
        }
    }

    // Función para limpiar tabla cuando se cambian los filtros
    function clearTableOnFilterChange() {
        var table = $('#tablaPlanilla').DataTable();
        table.clear().draw();
        // Deshabilitar botón guardar cuando se limpie la tabla
        verificarBotonGuardar();
    }



</script>

