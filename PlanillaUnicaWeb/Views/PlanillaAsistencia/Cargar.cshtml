    }

    .day-label {
        display: block;
        font-weight: bold;
    }

    .day-number {
        display: block;
        font-size: 0.9em;
    }





    /* SOLUCIÓN CSS PARA COLUMNAS FIJAS SIN FIXEDCOLUMNS - VERSIÓN SIMPLIFICADA */

    /* Configuracion básica de la tabla */
    #tablaPlanilla {
        width: 100% !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
    }

    /* Contenedor con scroll horizontal */
    .dataTables_scrollBody {
        overflow-x: auto !important;
        position: relative;
    }

    /* COLUMNAS FIJAS - Primera columna (Checkbox) */
    #tablaPlanilla th:nth-child(1),
    #tablaPlanilla td:nth-child(1) {
        position: -webkit-sticky;
