@model IEnumerable<Object>
@{
    List<PlanillaUnicaWeb.Models.Gen_Empresa> lstEmpresa = Model.ToList()[0] as List<PlanillaUnicaWeb.Models.Gen_Empresa>;
    List<PlanillaUnicaWeb.Models.Gen_Centro_Costo> lstCentroCosto = Model.ToList()[1] as List<PlanillaUnicaWeb.Models.Gen_Centro_Costo>;
    List<PlanillaUnicaWeb.Models.Gen_Ano> lstAno = Model.ToList()[2] as List<PlanillaUnicaWeb.Models.Gen_Ano>;
    List<PlanillaUnicaWeb.Models.Rh_Asistencia_Concepto> lstAsistenciaConceptos = Model.ToList()[3] as List<PlanillaUnicaWeb.Models.Rh_Asistencia_Concepto>;
    PlanillaUnicaWeb.Models.FiltroPlanilla filtroPlanilla = Model.ToArray()[4] as PlanillaUnicaWeb.Models.FiltroPlanilla;
    List<PlanillaUnicaWeb.Models.AsistenciaLista> lstAsistencia = Model.ToList()[5] as List<PlanillaUnicaWeb.Models.AsistenciaLista>;


    string classAlerta = string.Empty;

    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@{ Html.EnableClientValidation(true);
    Html.EnableUnobtrusiveJavaScript(true); }

<script>
    $(document).ready(function (e) {

        $('#tablaPlanilla').DataTable(
            {
                "scrollY": 530,
                "paging": false,
                "language": {
                    "lengthMenu": "Motrar _MENU_ registros por página",
                    "zeroRecords": "Sin información",
                    "search": "Buscar:",
                    "info": "Mostrando _START_ a _END_ de un total de _TOTAL_ Registros",
                    "infoEmpty": "Sin información disponible",
                    "infoFiltered": "(filtered from _MAX_ total records)",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "paginate": {
                        "first": "Primero",
                        "last": "Ultimo",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            }
        );

        // Evento change para el select de periodos
        $('#periodoDropdown').change(function () {
            const periodo = $(this).val();

            // Limpiar select de ciudades
            $('#numeroSemanaDropdown').empty();
            $('#numeroSemanaDropdown').append($('<option>').val('').text('-- Seleccione Semana --')); // Opción por defecto

            if (periodo) {

                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("BuscaSemanasPeriodo", "PlanillaAsistencia")',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: { periodo: periodo },

                    success: function (response) {
                        // Limpiar select
                        $('#numeroSemanaDropdown').empty();

                        // Agregar opción por defecto
                        $('#numeroSemanaDropdown').append('<option value="">Seleccione Semana</option>');

                        // Llenar con datos de la API
                        if (response.data && response.data.length > 0) {
                            $.each(response.data, function (index, item) {
                                if (item.Activa) {
                                    $('#numeroSemanaDropdown').append(`<option value="${item.NumeroSemana}" data-fecini="${item.FechaInicioSemana}" data-fecfin="${item.FechaFinSemana}" selected> Semana ${item.NumeroSemana} del ${item.Ano} ( ${item.FechaInicioSemana} al ${item.FechaFinSemana} )</option>`);
                                    $('#filtroPlanilla_FechaInicio').val(item.FechaInicioSemana);
                                    $('#filtroPlanilla_FechaTermino').val(item.FechaFinSemana);
                                } else
                                    $('#numeroSemanaDropdown').append(`<option value="${item.NumeroSemana}" data-fecini="${item.FechaInicioSemana}" data-fecfin="${item.FechaFinSemana} "> Semana ${item.NumeroSemana} del ${item.Ano} ( ${item.FechaInicioSemana} al ${item.FechaFinSemana} )</option>`);

                            });
                        } else {
                            $('#numeroSemanaDropdown').append(`<option value="" data-fecini="" data-fecfin="" >No hay datos disponibles</option>`);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al cargar datos:', error);
                        $('#numeroSemanaDropdown').empty();
                        $('#numeroSemanaDropdown').append('<option value="">Error al cargar semanas</option>');
                    },
                    complete: function () {
                        // Habilitar select
                        $('#numeroSemanaDropdown').prop('disabled', false);
                    }

                });
            }
        });

        // Evento change para el select de semanas
        $('#numeroSemanaDropdown').change(function () {
            const opcionSeleccionada = $(this).find('option:selected');
            const fechaIni = opcionSeleccionada.data('fecini');
            const fechaFin = opcionSeleccionada.data('fecfin');
            $('#filtroPlanilla_FechaInicio').val(fechaIni);
            $('#filtroPlanilla_FechaTermino').val(fechaFin);
        });

        setTimeout(function () {
            $(".content").fadeOut(1500);
        }, 3000);

    });

</script>


