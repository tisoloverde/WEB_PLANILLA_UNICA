@model IEnumerable<Object>
@{
    List<PlanillaUnicaWeb.Models.Gen_Empresa> lstEmpresa = Model.ToList()[0] as List<PlanillaUnicaWeb.Models.Gen_Empresa>;
    List<PlanillaUnicaWeb.Models.Gen_Centro_Costo> lstCentroCosto = Model.ToList()[1] as List<PlanillaUnicaWeb.Models.Gen_Centro_Costo>;
    List<PlanillaUnicaWeb.Models.Gen_Centro_Costo> lstCentroCostoTodos = Model.ToList()[2] as List<PlanillaUnicaWeb.Models.Gen_Centro_Costo>;
    List<PlanillaUnicaWeb.Models.Gen_Ano> lstAno = Model.ToList()[3] as List<PlanillaUnicaWeb.Models.Gen_Ano>;
    List<PlanillaUnicaWeb.Models.Rh_Asistencia_Concepto> lstAsistenciaConceptos = Model.ToList()[4] as List<PlanillaUnicaWeb.Models.Rh_Asistencia_Concepto>;
    List<PlanillaUnicaWeb.Models.Rh_Asistencia_Concepto> lstAsistenciaConceptosVisibles = Model.ToList()[5] as List<PlanillaUnicaWeb.Models.Rh_Asistencia_Concepto>;
    List<PlanillaUnicaWeb.Models.Rh_Asistencia_Concepto> lstAsistenciaConceptosRexmas = Model.ToList()[6] as List<PlanillaUnicaWeb.Models.Rh_Asistencia_Concepto>;
    List<PlanillaUnicaWeb.Models.Rh_Asistencia_Concepto> lstAsistenciaConceptosInternos = Model.ToList()[7] as List<PlanillaUnicaWeb.Models.Rh_Asistencia_Concepto>;
    PlanillaUnicaWeb.Models.FiltroPlanilla filtroPlanilla = Model.ToArray()[8] as PlanillaUnicaWeb.Models.FiltroPlanilla;
    List<PlanillaUnicaWeb.Models.Rh_Cargo_Generico> lstCargosGenericos = Model.ToList()[9] as List<PlanillaUnicaWeb.Models.Rh_Cargo_Generico>;
    List<PlanillaUnicaWeb.Models.Rh_Referencia_1> lstReferencias1 = Model.ToList()[10] as List<PlanillaUnicaWeb.Models.Rh_Referencia_1>;
    List<PlanillaUnicaWeb.Models.Rh_Referencia_2> lstReferencias2 = Model.ToList()[11] as List<PlanillaUnicaWeb.Models.Rh_Referencia_2>;
    List<PlanillaUnicaWeb.Models.AsistenciaLista> lstAsistencia = Model.ToList()[12] as List<PlanillaUnicaWeb.Models.AsistenciaLista>;

    string classAlerta = string.Empty;

    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@{ Html.EnableClientValidation(true);
    Html.EnableUnobtrusiveJavaScript(true); }

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<style>

    th, td {
        white-space: nowrap;
    }

    div.dataTables_wrapper {
        margin: 0 auto;
    }

    div.container {
        width: 80%;
    }

    .circulo-rojo {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: red;
        margin-right: 5px; /* Espacio entre el circulo y el texto */
    }

    .circulo-amarillo {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: orange;
        margin-right: 5px; /* Espacio entre el circulo y el texto */
    }

    .circulo-verde {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: green;
        margin-right: 5px; /* Espacio entre el circulo y el texto */
    }


    /* Correccion: Preservar alineacion original de texto */
    #tablaPlanilla td[style*="text-align: left"] {
        text-align: left !important;
    }

    #tablaPlanilla td[style*="text-align: right"] {
        text-align: right !important;
    }

    #tablaPlanilla td[style*="text-align: center"] {
