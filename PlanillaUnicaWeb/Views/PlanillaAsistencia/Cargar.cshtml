<script>

    var centrosCostoList = @Html.Raw(Json.Encode(lstCentroCosto));

    $(document).ready(function () {
        // Cuando se seleccione una empresa para cargar los centros de costo asociados
        $('#empresaDropdown').change(function () {
            var empresaId = $(this).val(); // Obtener el ID de la empresa

            // Limpiar el dropdown de centros de costo
            $('#centroCostoDropdown').empty();
            $('#centroCostoDropdown').append($('<option>').val('').text('-- Seleccione Centro de Costo --')); // Opción por defecto

            // Si hay una empresa seleccionada
            if (empresaId) {
                // Filtrar los centros de costo que pertenecen a la empresa seleccionada
                var filteredCentrosCosto = centrosCostoList.filter(function (item) {
                    return item.Genemp_Id == empresaId; // Comparar con la empresa seleccionada
                });

                // Llenar el dropdown con las centros de costo filtrados
                $.each(filteredCentrosCosto, function (index, item) {
                    $('#centroCostoDropdown').append($('<option>').val(item.Gencencos_Id).text(item.Gencencos_Codigo + ' - ' + item.Gencencos_Descripcion));
                });
            }
        });

        // Seteo de centro de costo al cargar en búsqueda
        let empresaId = document.getElementById('empresaDropdown').value;
        var filteredCentrosCosto = centrosCostoList.filter(function (item) {
            return item.Genemp_Id == empresaId; // Comparar con la empresa seleccionada
        });

        // Llenar el dropdown con las centros de costo filtrados
        $.each(filteredCentrosCosto, function (index, item) {
            $('#centroCostoDropdown').append($('<option>').val(item.Gencencos_Id).text(item.Gencencos_Codigo + ' - ' + item.Gencencos_Descripcion));
        });
        $('#centroCostoDropdown').val(@filtroPlanilla.Gencencos_Id);

        // Carga y seteo de semanas por periodo
        $.ajax({
            type: 'GET',
            url: '@Url.Action("BuscaSemanasPeriodo", "PlanillaAsistencia")',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data: { periodo: @filtroPlanilla.Periodo },

            success: function (response) {
                // Limpiar select
                $('#numeroSemanaDropdown').empty();

                // Agregar opción por defecto
                $('#numeroSemanaDropdown').append('<option value="">Seleccione Semana</option>');

                // Llenar con datos de la API
                if (response.data && response.data.length > 0) {
                    $.each(response.data, function (index, item) {
                        if (item.NumeroSemana == @filtroPlanilla.NumeroSemana ) {
                            $('#numeroSemanaDropdown').append(`<option value="${item.NumeroSemana}" data-fecini="${item.FechaInicioSemana}" data-fecfin="${item.FechaFinSemana}" selected> Semana ${item.NumeroSemana} del ${item.Ano} ( ${item.FechaInicioSemana} al ${item.FechaFinSemana} )</option>`);
                            $('#filtroPlanilla_FechaInicio').val(item.FechaInicioSemana);
                            $('#filtroPlanilla_FechaTermino').val(item.FechaFinSemana);
                        } else
                            $('#numeroSemanaDropdown').append(`<option value="${item.NumeroSemana}" data-fecini="${item.FechaInicioSemana}" data-fecfin="${item.FechaFinSemana}" > Semana ${item.NumeroSemana} del ${item.Ano} ( ${item.FechaInicioSemana} al ${item.FechaFinSemana} )</option>`);

                    });
                } else {
                    $('#numeroSemanaDropdown').append('<option value="">No hay datos disponibles</option>');
                }
            },
            error: function (xhr, status, error) {
                console.error('Error al cargar datos:', error);
                $('#numeroSemanaDropdown').empty();
                $('#numeroSemanaDropdown').append('<option value="">Error al cargar semanas</option>');
            },
            complete: function () {
                // Habilitar select
                $('#numeroSemanaDropdown').prop('disabled', false);
            }
        });
    });

</script>