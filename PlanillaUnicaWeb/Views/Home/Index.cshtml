@using PlanillaUnicaWeb.Models
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<script>
    $(document).ready(function () {

        setTimeout(function () {
            $(".content").fadeOut(1500);
        }, 3000);

    });
</script>

<style>
    .text-header {
        width: 100%;
        margin-bottom: 30px;
    }
</style>

<div class="container-fluid px-0">
    <div class="card shadow">

        @if (!(Session["user_Name"] == null))
        {
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <h4>
                            <i class="bi bi-house-door-fill me-2"></i>
                            Bienvenido <strong>@Session["user_Name"] @Session["user_Apellido"]!</strong>
                        </h4>
                        <p class="text-muted">
                            <i class="bi bi-calendar-event me-1"></i>
                            Sistema de Planilla Unica - @DateTime.Now.ToString("dd/MM/yyyy")
                        </p>
                        <hr />
                        <p>Use el menu de navegacion para acceder a las diferentes opciones del sistema.</p>
                    </div>
                    <div class="col-md-4 text-end">
                        <img src="~/img/planilla-unica-soloverde-new.png" alt="Planilla Unica SoloVerde" style="max-height: 80px;" class="img-fluid" />
                    </div>
                </div>
                
                @{
                    List<PlanillaUnicaWeb.Models.Account_Menu_Opcion> menuList = new List<PlanillaUnicaWeb.Models.Account_Menu_Opcion>();
                    if (!(Session["user_Menus"] == null))
                    {
                        menuList = Session["user_Menus"] as List<PlanillaUnicaWeb.Models.Account_Menu_Opcion>;
                    }
                    
                    // Verificar acceso a cada módulo
                    bool tieneDotacion = menuList.Any(m => m.Accmenopc_Controller == "Dotacion");
                    bool tienePlanillaAsistencia = menuList.Any(m => m.Accmenopc_Controller == "PlanillaAsistencia");
                    bool tieneListaPersonal = menuList.Any(m => m.Accmenopc_Controller == "ListaPersonal" || m.Accmenopc_Titulo.Contains("Lista Personal"));
                }

                <div class="row mt-4 justify-content-center">
                    @if (tieneDotacion)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card border-success">
                                <div class="card-body text-center">
                                    <i class="bi bi-people-fill text-success" style="font-size: 2rem;"></i>
                                    <h6 class="card-title mt-2">Dotacion</h6>
                                    <p class="card-text small">Gestion de empleados y personal</p>
                                    <a href="@Url.Action("Index", "Dotacion")" class="btn btn-success btn-sm">
                                        <i class="bi bi-arrow-right-circle mr-1"></i>Acceder
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    
                    @if (tieneListaPersonal)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card border-warning">
                                <div class="card-body text-center">
                                    <i class="bi bi-person-lines-fill text-warning" style="font-size: 2rem;"></i>
                                    <h6 class="card-title mt-2">Lista Personal</h6>
                                    <p class="card-text small">Consulta y gestion de personal</p>
                                    <a href="@Url.Action("Index", "ListaPersonal")" class="btn btn-warning btn-sm">
                                        <i class="bi bi-arrow-right-circle mr-1"></i>Acceder
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    
                    @if (tienePlanillaAsistencia)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card border-info">
                                <div class="card-body text-center">
                                    <i class="bi bi-calendar-check text-info" style="font-size: 2rem;"></i>
                                    <h6 class="card-title mt-2">Planilla de Asistencia</h6>
                                    <p class="card-text small">Control de horarios y asistencia</p>
                                    <a href="@Url.Action("Index", "PlanillaAsistencia")" class="btn btn-info btn-sm">
                                        <i class="bi bi-arrow-right-circle mr-1"></i>Acceder
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            using (Html.BeginForm("SignIn", "Account", null, FormMethod.Post, null))
            {
                <div class="card-body">
                    <div class="jumbotron bg-white shadow col-md-4 offset-md-4 mt-3 py-6">
                        <div class="row">
                            <div class="form-login col-lg-12">
                                <div class=" text-center">
                                    <img src="~/img/planilla-unica-soloverde-new.png" class="text-header" />
                                    <p class="text-muted">Bienvenido!</p>
                                </div>
                                <form class="mt-5" action="#">
                                    <div class="mb-4 col-lg-10 mx-auto">
                                        <label for="email" class="form-label fw-semibold">
                                            <i class="bi bi-person-circle me-2"></i>Email:
                                        </label>
                                        <input type="text"
                                               class="form-control"
                                               id="email"
                                               name="email"
                                               aria-describedby="emailHelp"
                                               placeholder="nombre@cimaurbano.cl" />
                                    </div>
                                    <div class="mb-4 col-lg-10 mx-auto">
                                        <label for="password" class="form-label fw-semibold">
                                            <i class="bi bi-key-fill me-2"></i>Contrasena:
                                        </label>
                                        <input type="password"
                                               class="form-control"
                                               id="password"
                                               name="password"
                                               placeholder="Tu contrasena" />
                                    </div>
                                    <div class="d-grid col-lg-10 mx-auto">
                                        <button type="submit" class="btn btn-primary btn-block">Ingresar</button>
                                    </div>
                                    @if (TempData["Mensaje"] != null)
                                    {
                                        <div class="content col-lg-10 mx-auto alert alert-danger">
                                            <button type="button" class="close" data-dismiss="toast" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                            @TempData["Mensaje"].ToString()
                                        </div>
                                    }

                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

    </div>
</div>
</content>
</invoke>